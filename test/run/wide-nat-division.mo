// Division for Nat128/Nat256, aimed at the cases the algorithm can actually get wrong.
// Expected values computed independently in arbitrary precision, not taken from moc.
//MOC-FLAG -A=M0194,M0198

// Division dispatches on the divisor: below 2^32 it is a single-digit long division,
// otherwise Knuth algorithm D in base 2^32. Both paths are exercised here, and so is the
// boundary between them.

func eq256(a : Nat256, b : Nat256) { assert (a == b) };
func eq128(a : Nat128, b : Nat128) { assert (a == b) };

// KNUTH D'S ADD-BACK. The estimated quotient digit is occasionally one too large even
// after the two correction steps, and the fix-up is a whole extra pass that fires on
// roughly one input in 2^31 -- so no random draw will ever reach it. These two inputs
// were found by instrumenting the branch to trap and searching for something that hit it.
eq256(340282366920938463463374607431768211456 / 18446744073709551617, 18446744073709551615);
eq256(340282366920938463463374607431768211456 % 18446744073709551617, 1);
eq128(170141183460469231731687303715884105728 / 18446744073709551617, 9223372036854775807);
eq128(170141183460469231731687303715884105728 % 18446744073709551617, 9223372036854775809);

