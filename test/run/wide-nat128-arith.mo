// Invariants that must hold whatever the operands are.
func invariants(a : N, b : N) {
  assert ((a +% b) -% b == a);
  assert ((a *% b) == (b *% a));
  assert ((a +% b) == (b +% a));
  if (b != 0) { assert ((a / b) * b + (a % b) == a); assert (a % b < b) };
  assert (a -% a == 0);
  assert (a *% 1 == a);
  assert (a *% 0 == 0);
};

