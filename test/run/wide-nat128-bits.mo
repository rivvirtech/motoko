// Invariants.
func invariants(a : N, b : N) {
  assert (a & a == a); assert (a | a == a); assert (a ^ a == 0);
  assert (^(^a) == a);
  assert (a & b == b & a); assert (a | b == b | a);
  assert ((a << 0) == a); assert ((a >> 0) == a);
  assert ((a <<> 0) == a); assert ((a <>> 0) == a);
  assert ((a <<> 128) == a);
  assert (Prim.popcntNat128(a) + Prim.popcntNat128(^a) == 128);
};

